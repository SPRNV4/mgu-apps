      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Automatic (the navigation, then where the car is)"
        ],
        [
          "right",
          "Right-hand traffic"
        ],
        [
          "left",
          "Left-hand traffic"
        ]
      ]
    },
    {
